{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCUsage Gauge",
  "version": "0.5.1",
  "identifier": "com.tacogips.ccusage-gauge",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCUsage Gauge",
        "width": 1480,
        "height": 920,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../Resources/DashboardIcon.png"]
  }
}
